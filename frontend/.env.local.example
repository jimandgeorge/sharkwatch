# ─── Frontend environment ───────────────────────────────────────────────────────
# Copy to .env.local for local dev. On Render these are set on the frontend service.
# .env.local is gitignored — never commit real secrets.

# Backend URL.
#   NEXT_PUBLIC_API_URL is baked into the browser bundle AT BUILD TIME.
#   API_URL is used for server-side fetches (server components, API routes).
#   Point both at the backend's public URL in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Auth — set AUTH_PASSWORD for shared-password login, or configure OIDC_* for SSO.
# Leave both blank to disable auth entirely (local dev only).
AUTH_PASSWORD=
NEXTAUTH_SECRET=generate-a-32-char-secret-here   # openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000               # this app's own public URL

# OIDC SSO (optional — Google, Okta, Auth0, Azure AD, etc.)
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Google

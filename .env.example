# ─── Backend environment ───────────────────────────────────────────────────────
# Copy to .env for local/Docker-Compose. On Render these are set per-service.

# Required
SECRET_KEY=generate-a-32-char-secret-here      # openssl rand -hex 32
DATABASE_URL=postgresql+asyncpg://user:pass@host/db   # Neon connection string
ENVIRONMENT=production                          # production hides /docs, gives generic errors

# Optional — declared but not used at runtime; safe to leave blank
REDIS_URL=

# Ingest API auth — leave blank to disable (local dev only).
# Prefer the hash in production:  python -c "import hashlib;print(hashlib.sha256(b'YOURKEY').hexdigest())"
API_KEY=
API_KEY_HASH=

# CORS — comma-separated origins allowed to call the API (the frontend's URL)
CORS_ORIGINS=http://localhost:3000

# LLM Provider: ollama | azure | bedrock | anthropic | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...                    # if LLM_PROVIDER=anthropic

# Ollama (if LLM_PROVIDER=ollama — the self-hosted on-prem default)
# OLLAMA_MODEL=llama3.1:70b
# OLLAMA_BASE_URL=http://ollama:11434

# Azure OpenAI (if LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# AWS Bedrock (if LLM_PROVIDER=bedrock)
# AWS_BEDROCK_REGION=eu-west-2
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ─── Docker-Compose only (single-server deploy) ────────────────────────────────
# POSTGRES_PASSWORD=changeme
# REDIS_PASSWORD=changeme
# NEXT_PUBLIC_API_URL=http://localhost:8000     # for Compose; on Render set on the frontend service
